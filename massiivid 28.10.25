middleElements = arr[len(arr)//2:]

print(firstElements)
print(middleElements)

nextask()

print(arr[-3:])
# [start:end:step]
# if step is negative, it goes backwards
# if " " is empty, it means start or end of the list
print(arr[-1::-1])

nextask()

arr.append("uus")
